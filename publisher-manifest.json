:flex;justify-content:space-between;gap:1.4rem;flex-wrap:wrap;font-size:.86rem}\n  .foot-grid p{margin:0 0 .4rem}\n  .foot-grid a{color:var(--ivory);border-bottom-color:rgba(246,240,228,.4)}\n  .foot-grid a:hover{background:rgba(246,240,228,.12)}\n\n  @media (max-width:880px){\n    .shell{grid-template-columns:1fr}\n    .sidebar{position:static;height:auto;padding:1.3rem 1.2rem;flex-direction:row;flex-wrap:wrap;align-items:center;gap:.8rem 1.4rem}\n    .sidebar .mark{border-bottom:none;padding-bottom:0;font-size:1.3rem}\n    .sidebar .mark span{display:none}\n    .toc{flex-direction:row;flex-wrap:wrap;gap:.2rem .9rem;font-size:.86rem}\n    .toc a{padding:.2rem 0 .2rem .5rem}\n    .sidebar .note{display:none}\n    .band-b .wrap{grid-template-columns:1fr}\n    .hero-facts{grid-template-columns:1fr}\n    .steps,.clients,.faq-groups{grid-template-columns:1fr}\n    .plan.tier-1,.plan.tier-2,.plan.tier-3{margin-left:0;margin-right:0}\n    .plan.tier-2{background:#fffaf0}\n  }\n  @media (max-width:520px){\n    .band{padding:2.2rem 0}\n    .wrap{padding:0 1.1rem}\n    .section{padding:2.4rem 0}\n  }\n</style><div class=\"shell\">\n\n  <aside class=\"sidebar\">\n    <div class=\"mark\">WUXX<span>订阅说明页</span></div>\n    <nav class=\"toc\" aria-label=\"页面目录\">\n      <a href=\"#intro\">这一页讲什么</a>\n      <a href=\"#howto\">怎么开始用</a>\n      <a href=\"#plans\">套餐怎么选</a>\n      <a href=\"#clients\">客户端说明</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#contact\">还差一句</a>\n    </nav>\n    <p class=\"note\">如果某段读着别扭，可以先去 FAQ 找找，那里按主题分了组。</p>\n  </aside>\n\n  <main>\n\n    \n    <section class=\"band band-a\" id=\"intro\">\n      <div class=\"wrap\">\n        <p class=\"eyebrow\">WUXX · 写在最上面</p>\n        <h1>WUXX，先把话说明白</h1>\n        <p class=\"hero-lead\">这是一个按页面把订阅、客户端和常见问题摆开的说明页。我们不急着让你下单，先让你弄清楚自己需要的是哪一档、手上哪台设备能用、遇到不清楚的地方该去哪儿问。</p>\n        <p class=\"hero-lead\">下面每一层色带对应一件事。从上往下读可以，跳着看你关心的那一段也行。</p>\n        <dl class=\"hero-facts\">\n          <div>\n            <dt>当前版本</dt>\n            <dd>三档订阅</dd>\n          </div>\n          <div>\n            <dt>起价</dt>\n            <dd>¥15 / 月</dd>\n          </div>\n          <div>\n            <dt>年付方式</dt>\n            <dd>按月价 × 10</dd>\n          </div>\n        </dl>\n      </div>\n    </section>\n\n    <section class=\"band band-b\">\n      <div class=\"wrap\">\n        <div>\n          <h2>先坦白一句</h2>\n          <p>WUXX 现在能给你的，是一份把选择讲清楚的说明。流量、设备数、线路类型都写在下面，价格也直接标出来，不藏在「咨询客服」后面。</p>\n          <p>如果你只想要一句结论：日常刷流媒体、两三个人用，基础版够了；想让多设备同时在、并且对晚高峰有点要求，看旗舰版；需要多人共享或者想自己安排路由，直接翻到团队版。</p>\n        </div>\n        <blockquote class=\"pullquote\">\n          选套餐这件事，最怕的不是贵，是选错。\n          <small>—— 所以我们把差别写在了纸面上</small>\n        </blockquote>\n      </div>\n    </section>\n\n    \n    <section class=\"section\" id=\"howto\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"num\">01</span>\n          <h2>怎么开始用</h2>\n        </div>\n        <p class=\"lede\">四步，按顺序走一遍就好。没有隐藏步骤，也没有「先加好友再告诉你」的环节。</p>\n        <div class=\"steps\">\n          <article class=\"step\">\n            <span class=\"idx\">1</span>\n            <h3>挑一档订阅</h3>\n            <p>看后面的套餐区块，重点盯两件事：每月流量够不够、要同时在线的设备有几台。这两项基本决定了你该停在哪一档。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"idx\">2</span>\n            <h3>确认想付多久</h3>\n            <p>月付灵活，年付按十个月算。先月付试一个月，觉得顺手再换年付，不需要一次把钱压在长周期上。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"idx\">3</span>\n            <h3>装到设备上</h3>\n            <p>按客户端区块的说明挑对应平台。装完先看一下当前版本，再决定要不要跟着更新。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"idx\">4</span>\n            <h3>用一周再判断</h3>\n            <p>头几天关注你最常用的那个时段。同样的套餐，不同时段体感不一样，这比看参数更实在。</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"section\" id=\"plans\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"num\">02</span>\n          <h2>套餐怎么选</h2>\n        </div>\n        <p class=\"lede\">三档从左到右逐级加码：流量变多、设备变多、能做的事也变多。别按价格排序，按你的使用场景排序。</p>\n        <div class=\"plans\">\n\n          <article class=\"plan tier-1\">\n            <div class=\"plan-top\">\n              <h3>基础版</h3>\n              <p class=\"price\">¥15/月<small>按年付 ¥150 / 年</small></p>\n            </div>\n            <ul>\n              <li>每月 100GB 流量</li>\n              <li>3 台设备同时在线</li>\n              <li>基础流媒体解锁</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <p class=\"plan-foot\">适合一个人、一台主力设备加备机，日常刷剧和查资料。</p>\n          </article>\n\n          <article class=\"plan tier-2\">\n            <div class=\"plan-top\">\n              <h3>旗舰版<span class=\"tag\">多数人停在这里</span></h3>\n              <p class=\"price\">¥35/月<small>按年付 ¥350 / 年</small></p>\n            </div>\n            <ul>\n              <li>每月 300GB 流量</li>\n              <li>5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7×24 优先工单支持</li>\n            </ul>\n            <p class=\"plan-foot\">适合手机、平板、电脑一起用，晚上打游戏也想稳一点的人。</p>\n          </article>\n\n          <article class=\"plan tier-3\">\n            <div class=\"plan-top\">\n              <h3>团队版</h3>\n              <p class=\"price\">¥85/月<small>按年付 ¥850 / 年</small></p>\n            </div>\n            <ul>\n              <li>每月 1000GB 流量</li>\n              <li>20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <p class=\"plan-foot\">适合小团队共享，或者需要自己安排线路走向的场景。</p>\n          </article>\n\n        </div>\n        <p class=\"plan-foot\">上面标的价格是页面当前的挂牌价。实际结算以你下单时看到的金额为准；年付只按十个月计，不是额外赠送，也没有隐藏折扣。</p>\n      </div>\n    </section>\n\n    \n    <section class=\"section\" id=\"clients\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"num\">03</span>\n          <h2>客户端说明</h2>\n        </div>\n        <p class=\"lede\">下面是目前页面提到的几个平台方向。具体版本与获取方式以你实际看到的页面为准，这里不替任何下载地址背书。</p>\n        <div class=\"clients\">\n          <article class=\"client\">\n            <h4>桌面端 · Windows</h4>\n            <p>适合长时间挂着用，套餐里的设备数按登录设备计。</p>\n            <p class=\"state\">下载地址：暂未列出</p>\n          </article>\n          <article class=\"client\">\n            <h4>桌面端 · macOS</h4>\n            <p>安装前先确认系统版本，老系统可能跑不了最新客户端。</p>\n            <p class=\"state\">下载地址：暂未列出</p>\n          </article>\n          <article class=\"client\">\n            <h4>移动端 · Android</h4>\n            <p>手机和平板算两台设备，多设备同时用的时候记得数一下。</p>\n            <p class=\"state\">下载地址：暂未列出</p>\n          </article>\n          <article class=\"client\">\n            <h4>移动端 · iOS</h4>\n            <p>受应用商店规则影响，获取方式和更新节奏以商店页面为准。</p>\n            <p class=\"state\">下载地址：暂未列出</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"section\" id=\"faq\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"num\">04</span>\n          <h2>常见问题</h2>\n        </div>\n        <p class=\"lede\">按主题分了三组：订阅与计费、使用与设备、支持与变更。先看属于哪一类，省得整页翻。</p>\n\n        <div class=\"faq-groups\">\n\n          <div class=\"faq-group\">\n            <h3>订阅与计费</h3>\n\n            <article class=\"qa\">\n              <h4>年付是怎么算的？</h4>\n              <p>按十个月计：基础版 ¥150、旗舰版 ¥350、团队版 ¥850。不是额外打折叠加，就是月价乘以十。</p>\n            </article>\n\n            <article class=\"qa\">\n              <h4>可以先月付再换年付吗？</h4>\n              <p>可以这样安排。先按月付跑一个月，确认日常用量和体感都合适，再换到年付，不用一开始就压长周期。</p>\n            </article>\n\n            <article class=\"qa\">\n              <h4>用超了流量会怎样？</h4>\n              <p>页面目前只写明了每档的每月额度，超出之后的具体处理方式没有写在这份说明里。遇到这种情况，建议直接走工单问清楚，不要自己猜。</p>\n            </article>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>使用与设备</h3>\n\n            <article class=\"qa\">\n              <h4>「同时在线设备数」怎么数？</h4>\n              <p>按同一时间登录使用的设备来算。基础版 3 台、旗舰版 5 台、团队版 20 台。手机和平板分别各算一台，不要合并计算。</p>\n            </article>\n\n            <article class=\"qa\">\n              <h4>三档套餐的线路有什么不同？</h4>\n              <p>基础版是普通线路节点池；旗舰版在流媒体解锁上覆盖全部节点，并加了 IPLC 专线做游戏加速优化；团队版走 VIP 专属高带宽节点，还支持企业定制路由。</p>\n            </article>\n\n            <article class=\"qa\">\n              <h4>头几天体感不稳定，正常吗？</h4>\n              <p>不同时段的使用感受本来就会有差别。建议先记录你最常用的时间段，用满一周再判断，而不是装好当晚就下结论。</p>\n            </article>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>支持与变更</h3>\n\n            <article class=\"qa\">\n              <h4>哪些档位有优先支持？</h4>\n              <p>旗舰版提供 7×24 优先工单支持，团队版另外配有专属客户经理。基础版可以走常规工单，响应节奏以实际排队情况为准。</p>\n            </article>\n\n            <article class=\"qa\">\n              <h4>团队版能改成自己想要的线路吗？</h4>\n              <p>团队版的权益里包含企业定制路由这一项。具体怎么提需求、需要提供哪些信息，通过专属客户经理沟通会更直接。</p>\n            </article>\n\n            <article class=\"qa\">\n              <h4>页面上的价格以后会变吗？</h4>\n              <p>会有调整的可能。以你下单那一刻页面显示的金额为准，这份说明页只负责把当前三档的差别讲清楚，不做长期价格承诺。</p>\n            </article>\n          </div>\n\n        </div>\n      </div>\n    </section>\n\n    <section class=\"band band-d\" id=\"contact\">\n      <div class=\"wrap\">\n        <div class=\"foot-grid\">\n          <div>\n            <p><strong>WUXX</strong> · 订阅说明页</p>\n            <p>内容就是这些，没有别的彩蛋。</p>\n          </div>\n          <div>\n            <p><a href=\"#intro\">回到开头</a> · <a href=\"#plans\">再看套餐</a> · <a href=\"#faq\">翻常见问题</a></p>\n            <p>页面信息以实际下单时展示为准。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n</div>",
